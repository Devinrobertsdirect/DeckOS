{
  "name": "deckos",
  "version": "0.1.0",
  "description": "DeckOS — local AI that runs your system. One command to install and launch.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Devinrobertsdirect/DeckOS.git"
  },
  "homepage": "https://github.com/Devinrobertsdirect/DeckOS#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "deckos": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "deckos",
    "local-ai",
    "cyberdeck",
    "home-automation",
    "iot",
    "jarvis"
  ],
  "scripts": {
    "build": "node ./build.mjs",
    "dev": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "typescript": "~5.9.2"
  }
}
